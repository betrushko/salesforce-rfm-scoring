<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Weighted_Monetary__c</fullName>
    <description>Weighted monetary value: 70 percent trailing 12 month paid amount and 30 percent lifetime paid amount.</description>
    <formula>(0.7 * BLANKVALUE(Paid_Amount_12M__c, 0)) + (0.3 * BLANKVALUE(Lifetime_Paid_Amount__c, 0))</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Weighted Monetary</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
