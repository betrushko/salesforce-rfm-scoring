<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Since_Last_Payment__c</fullName>
    <description>Days elapsed since the last successful payment.</description>
    <externalId>false</externalId>
    <formula>IF(
    ISBLANK(Last_Successful_Payment_Date__c),
    NULL,
    TODAY() - Last_Successful_Payment_Date__c
)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Days Since Last Payment</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackTrending>false</trackTrending>
    <type>Number</type>
</CustomField>
